<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; the platform theme only needs to stay out
         of the way and keep the system bars transparent. -->
    <style name="Theme.SoundBridge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
