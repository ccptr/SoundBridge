pkgbase = soundbridge-bin
	pkgdesc = Low-latency audio link between a phone and a PC: command-line tool and desktop app (release binaries)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/ccptr/SoundBridge
	arch = x86_64
	license = GPL-2.0-or-later
	depends = alsa-lib
	depends = gcc-libs
	depends = glibc
	depends = libpipewire
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-driver
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = pipewire-audio: pw-loopback, for the virtual microphone
	provides = soundbridge=0.1.0
	conflicts = soundbridge
	options = !debug
