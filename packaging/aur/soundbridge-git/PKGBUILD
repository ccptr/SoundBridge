# Maintainer: ccptr <cccptr@protonmail.com>

pkgname=soundbridge-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Low-latency audio link between a phone and a PC: command-line tool and desktop app"
arch=('x86_64' 'aarch64')
url="https://github.com/ccptr/SoundBridge"
license=('GPL-2.0-or-later')
depends=(
  'alsa-lib'
  'gcc-libs'
  'glibc'
  'libpipewire'
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-driver'
  'vulkan-icd-loader'
  'wayland'
)
makedepends=('cargo' 'clang' 'git')
optdepends=('pipewire-audio: pw-loopback, for the virtual microphone')
provides=("soundbridge=${pkgver%%.r*}")
conflicts=('soundbridge')
# The C code in the dependency tree is linked by rustc, which cannot read the
# GCC LTO objects makepkg would otherwise have it built as.
options=('!lto')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # There are no release tags yet, so the version is the one in Cargo.toml.
  printf '%s.r%s.g%s' \
    "$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\(.*\)"/\1/p' Cargo.toml)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 -t "$pkgdir/usr/bin" \
    target/release/soundbridge target/release/soundbridge-desktop
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  install -Dm644 -t "$pkgdir/usr/share/applications" crates/desktop/assets/soundbridge.desktop
  install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps" crates/desktop/assets/soundbridge.svg
}
