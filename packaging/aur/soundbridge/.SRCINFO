pkgbase = soundbridge
	pkgdesc = Low-latency audio link between a phone and a PC: command-line tool and desktop app
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/ccptr/SoundBridge
	arch = x86_64
	arch = aarch64
	license = GPL-2.0-or-later
	makedepends = cargo
	makedepends = clang
	makedepends = git
	depends = alsa-lib
	depends = gcc-libs
	depends = glibc
	depends = libpipewire
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-driver
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = pipewire-audio: pw-loopback, for the virtual microphone
	options = !lto
	source = soundbridge::git+https://github.com/ccptr/SoundBridge.git#tag=v0.2.0
	sha256sums = SKIP

pkgname = soundbridge
